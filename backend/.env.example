# ==========================================
# FieldAI Assistant — Backend Configuration
# ==========================================

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=True
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# AI Providers
# Gemini API Key (Main LLM reasoning, multimodal vision, tool calling)
GEMINI_API_KEY=your_gemini_api_key_here

# NVIDIA API Key (Used strictly for RAG embeddings via nemotron-3-embed-1b)
# Identifier: NVIDIABuild-Autogen-59
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_EMBEDDING_MODEL=nemotron-3-embed-1b
NVIDIA_API_ENDPOINT=https://integrate.api.nvidia.com/v1

# Storage & Uploads
UPLOAD_DIR=data/uploads
CHROMA_PERSIST_DIR=.chroma
DATABASE_URL=sqlite:///./field_ai.db
