# ==========================================
# FieldAI Assistant — Backend Configuration
# ==========================================
# Copy this file to .env and fill in your actual keys.
# NEVER commit .env to version control.

# ── Server ────────────────────────────────
HOST=127.0.0.1
PORT=8000
DEBUG=True
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# ── Gemini — Non-RAG AI features ──────────
# Used for: multimodal vision, troubleshooting reasoning, diagnostic synthesis
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro-latest

# ── NVIDIA — RAG pipeline only ────────────
# NVIDIA_EMBEDDING_MODEL: embeds PDF chunks and queries for ChromaDB retrieval
# NVIDIA_RAG_MODEL: LLM for grounded answer generation (OpenAI-compatible endpoint)
# NVIDIA_API_ENDPOINT: NVIDIA's OpenAI-compatible base URL (do not change)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_EMBEDDING_MODEL=nemotron-3-embed-1b
NVIDIA_RAG_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_API_ENDPOINT=https://integrate.api.nvidia.com/v1

# ── Storage & Uploads ─────────────────────
UPLOAD_DIR=data/uploads
CHROMA_PERSIST_DIR=app/data/chroma_db
DATABASE_URL=sqlite:///./field_ai.db

# ── MongoDB — Application Database ──────────
# Used for: users, equipment records, diagnostics, maintenance history, error logs
# Get a free connection string at: https://mongodb.com/atlas (free tier available)
# Local:   mongodb://localhost:27017
# Atlas:   mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=fieldai

# ── Authentication & JWT ──────────────────
JWT_SECRET_KEY=generate_a_secure_random_secret_for_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
